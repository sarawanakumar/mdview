<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Merged with the Info.plist Xcode generates from build settings.
     Spec section 1: mdview opens Markdown files as a viewer. -->
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Markdown document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>NSDocumentClass</key>
			<string>$(PRODUCT_MODULE_NAME).MarkdownDocument</string>
			<!-- Alternate: offered in Open With and can be made the default,
			     but never takes over .md files on its own. -->
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>net.daringfireball.markdown</string>
				<string>com.inferly.mdview.markdown-extension</string>
			</array>
		</dict>
	</array>
	<!-- macOS declares net.daringfireball.markdown for .md and .markdown
	     only, and an app can't add extensions to a system type. So .mdown and
	     .mkd get a type of mdview's own that counts as Markdown
	     (spec section 1, "Supported files"). -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.inferly.mdview.markdown-extension</string>
			<key>UTTypeDescription</key>
			<string>Markdown document</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>net.daringfireball.markdown</string>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>mdown</string>
					<string>mkd</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
